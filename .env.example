# taper environment variables (spec #52, US14)
#
# Copy to .env (compose reads it automatically) or export in your shell.
# Values marked DEV-ONLY are insecure local-run defaults; the containers
# profile must provide real values (spec #52, US29: no usable dev secret
# ships in the images).

# ── Gateway ─────────────────────────────────────────────────────────────────
# REQUIRED. JWT signing secret (HS256). No default is applied: the gateway
# exits at boot when this is absent or blank.
GATEWAY_JWT_SECRET=
# Listen address for the REST API.
GATEWAY_ADDR=:8080
# Downstream gRPC endpoints.
STOCK_ADDR=localhost:50051
RESERVATION_ADDR=localhost:50052
ORDER_ADDR=localhost:50053
# Per-tenant rate limiting (token bucket, per-process not global).
# REQUIRED for the gateway; invalid/unset values fail boot.
GATEWAY_RATE_PER_TENANT=10
GATEWAY_BURST_PER_TENANT=20
# Bucket floor: evict least-recently-used idle tenants beyond this many
# buckets (0 = unbounded, the dev default).
GATEWAY_RATE_BUCKET_FLOOR=0

# ── Stock service ───────────────────────────────────────────────────────────
STOCK_ADDR=:50051
# DEV-ONLY credentials; containers profile must override.
STOCK_DATABASE_URL=postgres://taper_app:taperapp@localhost:5432/taper_db
STOCK_SWEEPER_DATABASE_URL=postgres://taper_sweeper:tapersweeper@localhost:5432/taper_db
# Nightly reconciliation (ADR-0001), off unless enabled.
RECONCILE_ENABLED=
RECONCILE_INTERVAL=24h

# ── Reservation service ─────────────────────────────────────────────────────
RESERVATION_ADDR=:50052
# DEV-ONLY credentials; containers profile must override.
RESERVATION_DATABASE_URL=postgres://taper_app:taperapp@localhost:5432/reservation_db
SWEEPER_DATABASE_URL=postgres://taper_sweeper:tapersweeper@localhost:5432/reservation_db
STOCK_ADDR=localhost:50051

# ── Order service ───────────────────────────────────────────────────────────
ORDER_ADDR=:50053
# DEV-ONLY credentials; containers profile must override.
ORDER_DATABASE_URL=postgres://taper_app:taperapp@localhost:5432/order_db
ORDER_SWEEPER_DATABASE_URL=postgres://taper_sweeper:tapersweeper@localhost:5432/order_db
RESERVATION_ADDR=localhost:50052
STOCK_ADDR=localhost:50051
# Crash-recovery resume loop (spec #44 T5). 1/true enables.
SAGA_RESUME_ENABLED=

# ── Fulfillment consumer ────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:29092
STOCK_ADDR=localhost:50051
FULFILLMENT_GROUP_ID=fulfillment

# ── Channelsync consumer ────────────────────────────────────────────────────
# DEV-ONLY credentials; containers profile must override.
CHANNELSYNC_DATABASE_URL=postgres://taper_app:taperapp@localhost:5432/channelsync_db
KAFKA_BROKERS=localhost:29092
CHANNELSYNC_GROUP_ID=channelsync

# ── Shared operational knobs ────────────────────────────────────────────────
# Admin/metrics listener (Prometheus /metrics, /healthz, /readyz).
METRICS_ADDR=:9101
# OpenTelemetry OTLP trace endpoint; empty = no-op providers (valid context,
# never-sampled spans).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Bounded drain window for graceful shutdown, e.g. 15s.
TAPER_DRAIN=15s
# Connection pool cap per service database (pkg/database).
DB_POOL_MAX_CONNS=20
# Outbox retention worker (ADR-0002), off unless enabled.
OUTBOX_PRUNE_ENABLED=
OUTBOX_PRUNE_INTERVAL=1h
# Idempotency retention owner (spec #52 US18), off unless enabled.
IDEMPOTENCY_PRUNE_ENABLED=
IDEMPOTENCY_PRUNE_INTERVAL=1h
IDEMPOTENCY_PRUNE_RETENTION=168h

# ── TLS posture (spec #52, B2 / US10-11) ───────────────────────────────────
# Dials: CA bundle verifying server certs; optional client cert (mTLS);
# optional SNI override when dialing by IP. GRPC_INSECURE=1 is the explicit
# local-dev plaintext escape hatch — never set it in a deployed profile.
GRPC_TLS_CA=
GRPC_TLS_CLIENT_CERT=
GRPC_TLS_CLIENT_KEY=
GRPC_TLS_SERVER_NAME=
GRPC_INSECURE=
# gRPC listeners: serve TLS when both are set (per service binary).
GRPC_TLS_CERT=
GRPC_TLS_KEY=
# Gateway HTTPS termination.
GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=
# Dev self-signed material: openssl req -x509 -newkey ec -pkeyopt \
#   ec_paramgen_curve:P-256 -nodes -keyout server.key -out server.pem \
#   -subj "/CN=localhost" -addext "subjectAltName=DNS:localhost"
# then point the clients' GRPC_TLS_CA at server.pem.

# ── Load harness (scripts/run-load.sh + load/*.js) ──────────────────────────
# Must match GATEWAY_JWT_SECRET.
SECRET=load-secret
